# Netlify Redirects for Tag Team Printing
# This file ensures proper SPA routing for Gatsby

# S&S Images proxy (handled by Netlify function)
/ss-images/*  /.netlify/functions/ss-images?path=:splat  200

# API routes to Netlify functions
/api/create-checkout  /.netlify/functions/create-checkout  200

# Redirect literal placeholder bracket routes (cleanup)
/products/[styleID]/[slug]  /products/  301
/products/[styleID]/[slug]/ /products/  301
/styles/[slug]             /products/  301
/styles/[slug]/            /products/  301
/brand/[slug]              /products/  301
/brand/[slug]/             /products/  301

# Gatsby client-side routing fallback - DO NOT redirect these
/cart                   /cart/index.html                 200
/cart/                  /cart/index.html                 200
/checkout               /checkout/index.html             200
/checkout/              /checkout/index.html             200
/products/*             /products/:splat/index.html      200
/shop/*                 /shop/:splat/index.html          200
/categories/*           /categories/:splat/index.html    200
/category/*             /category/:splat/index.html      200

# Gatsby 404 page fallback (for any non-matching routes)
# Was serving /index.html with a 200 -- meaning EVERY unmatched URL on the whole site,
# including the deleted brewery-merch-printing page and genuinely made-up URLs, silently
# served the homepage's real content as if it were a legitimate 200 page. Real 404 page
# (src/pages/404.jsx) already exists and builds to /404.html -- this rule just pointed at
# the wrong file. Status 404 keeps Netlify reporting a real not-found status to crawlers
# while still serving the nicer custom 404 page content.
/*                      /404.html                        404
